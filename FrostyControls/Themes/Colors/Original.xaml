<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Original theme: The classic Frosty greys with white text and no accent color. Every theme file defines the same keys. -->

    <!-- window backdrop behind panels -->
    <SolidColorBrush x:Key="WindowBackground" Color="#141414" />
    <!-- title bar (solid) -->
    <SolidColorBrush x:Key="TitlebarBackground" Color="#040404" />
    <!-- main text -->
    <SolidColorBrush x:Key="FontColor" Color="#F8F8F8" />
    <!-- buttons, toolbars, headers -->
    <SolidColorBrush x:Key="ControlBackground" Color="#454545" />
    <!-- hover on controls -->
    <SolidColorBrush x:Key="ControlHighlight" Color="#707070" />
    <!-- pressed controls -->
    <SolidColorBrush x:Key="ControlPressed" Color="#585858" />
    <!-- small glyphs drawn on controls (arrows) -->
    <SolidColorBrush x:Key="ButtonImage" Color="#D0D0D0" />
    <!-- scroll bar track -->
    <SolidColorBrush x:Key="ScrollbarBackground" Color="#232323" />
    <!-- top-level menu hover -->
    <SolidColorBrush x:Key="MenuItemHighlight" Color="#6C6C6C" />
    <!-- menu bar and menu popups -->
    <SolidColorBrush x:Key="MenuItemBackground" Color="#181818" />
    <!-- submenu item hover -->
    <SolidColorBrush x:Key="SubMenuItemHighlight" Color="#373737" />
    <!-- list/tree row hover -->
    <SolidColorBrush x:Key="SubItemHighlight" Color="#303030" />
    <!-- list/tree row selected -->
    <SolidColorBrush x:Key="SubItemPressed" Color="#404040" />
    <!-- lists and content areas -->
    <SolidColorBrush x:Key="ListBackground" Color="#292929" />

    <SolidColorBrush x:Key="AccentBrush" Color="#454545" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#707070" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#585858" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#707070" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#232323" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#868686" />
    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#868686" />
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="DisabledFontBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="IconBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionCloseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6C6C6C" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#66808080" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#DADADA" />
    <SolidColorBrush x:Key="HeaderFontBrush" Color="#FFFFFF" />

    <Color x:Key="AccentColor">#454545</Color>
    <Color x:Key="Accent2Color">#707070</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.5</sys:Double>
    <sys:Double x:Key="TitlebarDecoOpacity">0</sys:Double>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#454545" Offset="0" />
        <GradientStop Color="#707070" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitlebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#040404" Offset="0" />
        <GradientStop Color="#040404" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
