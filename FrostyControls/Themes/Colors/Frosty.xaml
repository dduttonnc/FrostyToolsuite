<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Frosty theme: Snow white and glacier blues, with frost in the title bar. Every theme file defines the same keys. -->

    <!-- window backdrop behind panels -->
    <SolidColorBrush x:Key="WindowBackground" Color="#E2F0FA" />
    <!-- title bar (solid) -->
    <SolidColorBrush x:Key="TitlebarBackground" Color="#D2E9F8" />
    <!-- main text -->
    <SolidColorBrush x:Key="FontColor" Color="#0C2A3E" />
    <!-- buttons, toolbars, headers -->
    <SolidColorBrush x:Key="ControlBackground" Color="#D7EBF9" />
    <!-- hover on controls -->
    <SolidColorBrush x:Key="ControlHighlight" Color="#C2E1F6" />
    <!-- pressed controls -->
    <SolidColorBrush x:Key="ControlPressed" Color="#ABD4F0" />
    <!-- small glyphs drawn on controls (arrows) -->
    <SolidColorBrush x:Key="ButtonImage" Color="#2F6487" />
    <!-- scroll bar track -->
    <SolidColorBrush x:Key="ScrollbarBackground" Color="#EAF5FC" />
    <!-- top-level menu hover -->
    <SolidColorBrush x:Key="MenuItemHighlight" Color="#CBE6F8" />
    <!-- menu bar and menu popups -->
    <SolidColorBrush x:Key="MenuItemBackground" Color="#EEF7FD" />
    <!-- submenu item hover -->
    <SolidColorBrush x:Key="SubMenuItemHighlight" Color="#DAEEFA" />
    <!-- list/tree row hover -->
    <SolidColorBrush x:Key="SubItemHighlight" Color="#EAF5FD" />
    <!-- list/tree row selected -->
    <SolidColorBrush x:Key="SubItemPressed" Color="#C6E6FA" />
    <!-- lists and content areas -->
    <SolidColorBrush x:Key="ListBackground" Color="#F9FCFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A78BC" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0869A6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#07588C" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#240A78BC" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#4FD1F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFF7FD" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#AED3EC" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#7FBAE0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#CCE3F3" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0A78BC" />
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#3F6680" />
    <SolidColorBrush x:Key="DisabledFontBrush" Color="#8FADC2" />
    <SolidColorBrush x:Key="IconBrush" Color="#1D4C6B" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#B6DAF0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0B7A5C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A15C00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C93434" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0A78BC" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionCloseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#94C4E6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6AAAD8" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#550A78BC" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#D2EAF9" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#1D4C6B" />
    <SolidColorBrush x:Key="HeaderFontBrush" Color="#082233" />

    <Color x:Key="AccentColor">#0A78BC</Color>
    <Color x:Key="Accent2Color">#4FD1F5</Color>
    <Color x:Key="ShadowColor">#2A6A99</Color>
    <sys:Double x:Key="ShadowOpacity">0.28</sys:Double>
    <sys:Double x:Key="TitlebarDecoOpacity">0.22</sys:Double>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A78BC" Offset="0" />
        <GradientStop Color="#4FD1F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitlebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#BFE1F6" Offset="0" />
        <GradientStop Color="#F3FAFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
