<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- DarkFrosty theme: Midnight glacier blues with an ice blue accent, with frost in the title bar. Every theme file defines the same keys. -->

    <!-- window backdrop behind panels -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0A1520" />
    <!-- title bar (solid) -->
    <SolidColorBrush x:Key="TitlebarBackground" Color="#0C1C2B" />
    <!-- main text -->
    <SolidColorBrush x:Key="FontColor" Color="#E2F0FA" />
    <!-- buttons, toolbars, headers -->
    <SolidColorBrush x:Key="ControlBackground" Color="#15293B" />
    <!-- hover on controls -->
    <SolidColorBrush x:Key="ControlHighlight" Color="#1D3850" />
    <!-- pressed controls -->
    <SolidColorBrush x:Key="ControlPressed" Color="#102131" />
    <!-- small glyphs drawn on controls (arrows) -->
    <SolidColorBrush x:Key="ButtonImage" Color="#8DB4D0" />
    <!-- scroll bar track -->
    <SolidColorBrush x:Key="ScrollbarBackground" Color="#0C1824" />
    <!-- top-level menu hover -->
    <SolidColorBrush x:Key="MenuItemHighlight" Color="#1B3349" />
    <!-- menu bar and menu popups -->
    <SolidColorBrush x:Key="MenuItemBackground" Color="#0D1A27" />
    <!-- submenu item hover -->
    <SolidColorBrush x:Key="SubMenuItemHighlight" Color="#182E42" />
    <!-- list/tree row hover -->
    <SolidColorBrush x:Key="SubItemHighlight" Color="#13253A" />
    <!-- list/tree row selected -->
    <SolidColorBrush x:Key="SubItemPressed" Color="#13486A" />
    <!-- lists and content areas -->
    <SolidColorBrush x:Key="ListBackground" Color="#0F1D2B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#81D4FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#29A8E0" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#04121C" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A4FC3F7" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#B3ECFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#112131" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#142638" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B1823" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#33597A" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#4A77A0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1A3046" />
    <SolidColorBrush x:Key="FocusBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#8FB0C8" />
    <SolidColorBrush x:Key="DisabledFontBrush" Color="#4F6A80" />
    <SolidColorBrush x:Key="IconBrush" Color="#BFDDF2" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#112233" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#24405A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60C5FA" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionCloseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C4A66" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#3D6283" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#664FC3F7" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#1B3550" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#BFDDF2" />
    <SolidColorBrush x:Key="HeaderFontBrush" Color="#F2FAFF" />

    <Color x:Key="AccentColor">#4FC3F7</Color>
    <Color x:Key="Accent2Color">#B3ECFF</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>
    <sys:Double x:Key="TitlebarDecoOpacity">0.3</sys:Double>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4FC3F7" Offset="0" />
        <GradientStop Color="#B3ECFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitlebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10304A" Offset="0" />
        <GradientStop Color="#0A1724" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
