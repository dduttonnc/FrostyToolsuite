<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light theme: Clean white and cool grey with a cobalt blue accent. Every theme file defines the same keys. -->

    <!-- window backdrop behind panels -->
    <SolidColorBrush x:Key="WindowBackground" Color="#EDF0F4" />
    <!-- title bar (solid) -->
    <SolidColorBrush x:Key="TitlebarBackground" Color="#F8F9FB" />
    <!-- main text -->
    <SolidColorBrush x:Key="FontColor" Color="#1A1E26" />
    <!-- buttons, toolbars, headers -->
    <SolidColorBrush x:Key="ControlBackground" Color="#E6EAF0" />
    <!-- hover on controls -->
    <SolidColorBrush x:Key="ControlHighlight" Color="#D9DFE8" />
    <!-- pressed controls -->
    <SolidColorBrush x:Key="ControlPressed" Color="#CAD2DE" />
    <!-- small glyphs drawn on controls (arrows) -->
    <SolidColorBrush x:Key="ButtonImage" Color="#4A5466" />
    <!-- scroll bar track -->
    <SolidColorBrush x:Key="ScrollbarBackground" Color="#F2F4F7" />
    <!-- top-level menu hover -->
    <SolidColorBrush x:Key="MenuItemHighlight" Color="#E2E7EE" />
    <!-- menu bar and menu popups -->
    <SolidColorBrush x:Key="MenuItemBackground" Color="#F8F9FB" />
    <!-- submenu item hover -->
    <SolidColorBrush x:Key="SubMenuItemHighlight" Color="#E8ECF2" />
    <!-- list/tree row hover -->
    <SolidColorBrush x:Key="SubItemHighlight" Color="#F0F3F7" />
    <!-- list/tree row selected -->
    <SolidColorBrush x:Key="SubItemPressed" Color="#DAE6FC" />
    <!-- lists and content areas -->
    <SolidColorBrush x:Key="ListBackground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F2563EB" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#7C3AED" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C8D0DB" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#A3AEBE" />
    <SolidColorBrush x:Key="DividerBrush" Color="#DFE4EA" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SecondaryFontBrush" Color="#586274" />
    <SolidColorBrush x:Key="DisabledFontBrush" Color="#9EA6B3" />
    <SolidColorBrush x:Key="IconBrush" Color="#3B4454" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#D3DAE3" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionCloseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B2BCC9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8E9AAB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#552563EB" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E3E8EF" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#3B4454" />
    <SolidColorBrush x:Key="HeaderFontBrush" Color="#0F1218" />

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="Accent2Color">#7C3AED</Color>
    <Color x:Key="ShadowColor">#1A2233</Color>
    <sys:Double x:Key="ShadowOpacity">0.22</sys:Double>
    <sys:Double x:Key="TitlebarDecoOpacity">0</sys:Double>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitlebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F8F9FB" Offset="0" />
        <GradientStop Color="#EDF1F6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
