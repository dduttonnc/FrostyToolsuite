<Window x:Class="Frosty.Core.Windows.FrostyTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frosty.Core.Windows"
        xmlns:ctrl2="clr-namespace:Frosty.Controls;assembly=FrostyControls"
        mc:Ignorable="d"
        Title=""
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid x:Name="taskWindow"
          Visibility="Visible"
          SnapsToDevicePixels="True">
        <Border Background="Transparent" />
        <Border Background="{DynamicResource ControlBackground}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="25,12,25,13"
                BorderBrush="{DynamicResource ListBackground}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="1" />
            </Border.Effect>
            <!-- [DAI fix] splash width with a banner or while the Detailed progress view has lines to show -->
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Width"
                            Value="600" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=Details, RelativeSource={RelativeSource AncestorType={x:Type local:FrostyTaskWindow}, Mode=FindAncestor}}"
                                           Value="" />
                                <Condition Binding="{Binding Path=HasHeader, RelativeSource={RelativeSource AncestorType={x:Type local:FrostyTaskWindow}, Mode=FindAncestor}}"
                                           Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Width"
                                    Value="350" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="23" />
                </Grid.RowDefinitions>

                <Grid x:Name="titlePanel"
                      Grid.Row="0"
                      Height="100">
                    <TextBlock x:Name="taskTextBlock"
                               Text="Header Text"
                               Foreground="{DynamicResource FontColor}"
                               Margin="0,0,0,0"
                               FontFamily="Global User Interface"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Grid>
                <ContentControl x:Name="headerPresenter"
                                Grid.Row="0"
                                Visibility="Collapsed" />

                <!-- [DAI fix] collapsed when empty, so the Simple view looks as before -->
                <TextBlock x:Name="detailsTextBlock"
                           Grid.Row="1"
                           Text="{Binding Path=Details, RelativeSource={RelativeSource AncestorType={x:Type local:FrostyTaskWindow}, Mode=FindAncestor}}"
                           Background="{DynamicResource WindowBackground}"
                           Padding="30,4,4,4"
                           FontSize="11"
                           Foreground="#C0C0C0"
                           FontFamily="Global User Interface"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <Trigger Property="Text"
                                         Value="">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="2"
                      Background="{DynamicResource WindowBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 x:Name="taskProgressBar"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Foreground="{DynamicResource ListBackground}"
                                 Value="{Binding Path=Progress, RelativeSource={RelativeSource AncestorType={x:Type local:FrostyTaskWindow}, Mode=FindAncestor}}" />
                    <ctrl2:FrostySpinner Width="20"
                                         Height="20" />

                    <TextBlock x:Name="statusTextBox"
                               Grid.Column="1"
                               Background="Transparent"
                               Text="{Binding Path=Status, RelativeSource={RelativeSource AncestorType={x:Type local:FrostyTaskWindow}, Mode=FindAncestor}}"
                               Padding="4,5,4,0"
                               Foreground="{DynamicResource FontColor}"
                               FontFamily="Global User Interface"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="cancelButton"
                            Grid.Column="2"
                            Margin="0"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            ToolTip="Cancel the task. (Esc)">
                        <Image Source="/FrostyControls;component/Images/CloseWindow.png" />
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FontColor}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Opacity"
                                                Value="0.6" />
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter Property="Opacity"
                                                Value="0.4" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5" />
                                        <Setter Property="ToolTip"
                                                Value="Cancelling" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
