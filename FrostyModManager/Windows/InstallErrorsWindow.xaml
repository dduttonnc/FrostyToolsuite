<ctrl:FrostyDockableWindow x:Class="FrostyModManager.InstallErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrostyModManager"
        xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
        mc:Ignorable="d"
        Title="Installation Report" Height="360" Width="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="/FrostyModManager;component/AppIcon.ico">
    <ctrl:FrostyDockableWindow.Resources>
        <local:ModStatusToBitmapSourceConverter x:Key="modStatusToBitmapSourceConverter"/>
    </ctrl:FrostyDockableWindow.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <ListView x:Name="errorListView" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Filename" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22" Margin="0,2">
                                        <TextBlock Text="{Binding Path=Filename}" FontFamily="Global User Interface" FontWeight="SemiBold" Foreground="{DynamicResource HeaderFontBrush}" VerticalAlignment="Top" Margin="0,3,10,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status" Width="490">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="22" Margin="0,2">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Height="20" Margin="4,0,8,0" VerticalAlignment="Top" Source="{Binding Path=IsWarning, Converter={StaticResource modStatusToBitmapSourceConverter}}" Opacity="0.9"/>
                                            <TextBlock Text="{Binding Path=Error}" FontFamily="Global User Interface" VerticalAlignment="Top" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Button Content="Ok" HorizontalAlignment="Right" Width="75" Margin="8,7,8,8" Click="Button_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Border>
    </Grid>
</ctrl:FrostyDockableWindow>
