<ctrl:FrostyDockableWindow x:Class="FrostyModManager.Windows.PrelaunchWindow2"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
                           Icon="/FrostyCore;component/AppIcon.ico"
                           mc:Ignorable="d"
                           Title="Load Profile" Height="250" Width="400" Loaded="Window_Loaded"
                           ResizeMode="NoResize" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource SurfaceBrush}">
            <StackPanel x:Name="GameInfoStackPanel" Margin="10,8">
                <TextBlock x:Name="ProfileNameTextBlock" Foreground="{DynamicResource HeaderFontBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProfilePathTextBlock" Foreground="{DynamicResource SecondaryFontBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="SelectGameTextBlock" Text="Select Game" Foreground="{DynamicResource SecondaryFontBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource AccentGradientBrush}"/>

        <Grid Grid.Row="2">
            <ListBox x:Name="ConfigurationListView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ConfigurationListView_OnSelectionChanged" MouseDoubleClick="ConfigurationListView_OnMouseDoubleClick" Background="{DynamicResource WindowBackground}" Padding="6">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="true" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="40"
                              Height="40">
                            <Image x:Name="ColorImage"
                                   Source="{Binding Path=Thumbnail}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Grid SnapsToDevicePixels="True">
                                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        <Border x:Name="Stroke" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"/>
                                        <Border x:Name="Check" Width="14" Height="14" CornerRadius="7" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="8" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubItemHighlight}"/>
                                            <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                            <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Stroke" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"/>
        <Grid Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" >
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <CheckBox x:Name="RememberProfileCheckBox" VerticalAlignment="Center" IsChecked="False" Content="Remember Profile" ToolTip="Automatically load profile when starting the Mod Manager." Padding="4, 0, 0, 1" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryFontBrush}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="5" Background="{DynamicResource SurfaceAltBrush}"/>
        
        <Grid Grid.Row="6" Background="{DynamicResource SurfaceAltBrush}" >
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="AddConfigurationButton" Content="Add" Padding="12,0" Margin="6,6,0,6" Click="AddConfigurationButton_OnClick"/>
                <Button x:Name="ModifyConfigurationButton" Content="Modify" Padding="12,0" Margin="6,6,0,6" Click="ModifyConfigurationButton_OnClick"/>
                <Button x:Name="RemoveConfigurationButton" Content="Remove" Padding="12,0" Margin="6,6,0,6" Click="RemoveConfigurationButton_OnClick"/>
                <Button x:Name="LaunchConfigurationButton" Content="Select" Padding="12,0" Margin="6,6,6,6" Click="LaunchConfigurationButton_OnClick" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" Padding="12,0" Margin="6,6,0,6" Click="CancelButton_OnClick"/>
                <Button x:Name="ScanButton" Content="Scan" Padding="12,0" Margin="6,6,0,6" Click="ScanButton_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</ctrl:FrostyDockableWindow>
