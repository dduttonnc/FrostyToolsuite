<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <runtime>
        <!-- [DAI fix] collect garbage on all cores; loading the game data creates millions of objects -->
        <gcServer enabled="true"/>
    </runtime>
</configuration>
